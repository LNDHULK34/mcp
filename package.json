    "lucide-react": "^0.511.0",
    "marked": "^15.0.0",
    "multer": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tar": "^7.4.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
